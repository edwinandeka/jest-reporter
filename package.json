{
  "name": "jest-reporter",
    "displayName": "Jest Reporter",
    "description": "Run tests with Jest and view results interactively in a webview.",
    "version": "1.5.1",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onCommand:extension.runJestTest",
    "onView:jestTestController"
  ],
  "main": "./src/back/extension.js",
  "contributes": {
    "configuration": {
      "properties": {
        "jestTestExplorer.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the test explorer when starting the project."
        }
      }
    },
    "testing": {
      "testProvider": "jestTestController"
    },
    "commands": [
      {
        "command": "extension.runJestTest",
        "title": "Jest Reporter: Run Test File",
        "category": "Testing"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.runJestTest",
          "when": "resourceFilename =~ /.spec.ts$/",
          "group": "testing"
        }
      ],
      "explorer/context": [
        {
          "command": "extension.runJestTest",
          "when": "resourceExtname == .ts && resourceFilename =~ /.spec.ts$/",
          "group": "testing"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.0.0",
    "vscode-test": "^1.4.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.3"
  },
  "icon": "images/logo-jest-reporter.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "publisher": "edwinandeka",
  "repository": {
    "url": "https://github.com/edwinandeka/jest-test-explorer.git",
    "type": "git"
  },
  "keywords": [
    "jest",
    "testing",
    "test explorer",
    "visual studio code"
  ]
}
